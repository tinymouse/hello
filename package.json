{
    "name": "hello",
    "version": "0.2.0",
    "description": "",
    "homepage": "https://github.com/tinymouse/hello",
    "author": {
        "name": "Tiny Mouse",
        "email": "khc04052@nifty.com"
    },
    "license": "ISC",
    "type": "commonjs",
    "main": "src/main.js",
    "devDependencies": {
        "electron": "^36.4.0",
        "electron-builder": "^26.0.12"
    },
    "dependencies": {
    },
    "scripts": {
        "build": "electron-builder build"
    },
    "build": {
        "appId": "com.electron.hello",
        "productName": "Hello",
        "win": {
            "target": "nsis",
            "icon": "res/icon/app.png"
        },
        "nsis": {
            "oneClick": false
        },
        "mac": {
            "target": "dmg",
            "icon": "res/icon/app.png"
        },
        "linux": {
            "target": "deb",
            "icon": "res/icon/app.png",
            "category": "Utility"
        },
        "publish": {
            "provider": "github",
            "releaseType": "release"
        }
    }
}
